<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nexusDesk.controllers.NoteController"
            stylesheets="@../css/style.css" styleClass="page">

    <top>
        <VBox fx:id="noteHeader" spacing="10">

            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <HBox fx:id="titleBox" spacing="8" alignment="CENTER_LEFT">

                <Label fx:id="noteTitle" text="Note" onMouseClicked="#returnToNotes"/>

                <Button fx:id="editTitleButton" styleClass="editTitleButton" text="✎" onAction="#editNoteTitle"/>
            </HBox>

        </VBox>
    </top>

    <center>
        <TextArea fx:id="noteContent" wrapText="true"/>
    </center>
</BorderPane>